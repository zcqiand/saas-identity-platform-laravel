{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "xr/laravel-harness-skeleton",
    "type": "project",
    "description": "xr-code-suite laravel profile 脚手架（Phase 0 骨架，零业务）",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "phpunit/phpunit": "^11.5",
        "symfony/yaml": "v7.4.21"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Harness\\": "tests/Harness/"
        }
    },
    "scripts": {
        "serve": "php serve.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
