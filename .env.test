# saas-identity-platform-laravel — phpunit 期覆盖
#
# L4 测试期 Laravel 按 APP_ENV 加载 .env.test（phpunit.xml APP_ENV=test）→
# key 集合与 .env.example 一致（L0.5 门）。直连库由本文件 PG_DATABASE 决定：
# 测试链 = saas_test（家族三库分层，multi-repo-family.md §6.2）。

# —— Server ——
SERVER_PORT=5110

# —— Database（saas_test 数据库, 全家族统一 PG_* 五件套） ——
DB_CONNECTION=pgsql
PG_HOST=127.0.0.1
PG_PORT=54321
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=saas_test

# —— JWT (HS256, ≥32B 硬约束) ——
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_TTL_SECONDS=3600
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
