# saas-identity-platform-laravel — 开发期环境变量模板
#
# L0.5 env 一致性门管理三件套：.env.example（dev）/.env.test（phpunit）本地 .env
# key 集合严格相等；secret 值由 deploy 注入（不 commit 真密钥）。
# 键名镜像 saas-identity-platform-rails 家族口径（PG_* 五件套 + JWT + SERVER_PORT）；
# laravel 额外需要 DB_CONNECTION 选连接（映射进 config/database.php，无默认值兜底）。
# L4.db.* 真跑需 dev 机器配真 PG（127.0.0.1:54321 + saas_dev/saas_test 库）。

# —— Server ——
# fail-fast：缺失/非法值 serve.php 即退出，禁止默认值兜底（suite-hard-rules §1）。
# 端口 X10 槽：saas-identity-platform-laravel = 5110 ｜ lab-management-system-laravel = 5210
SERVER_PORT=5110

# —— Database（saas_dev 数据库, 全家族统一 PG_* 五件套） ——
# DB_CONNECTION 选 config/database.php 里的连接；PG_* 是该连接的真实来源。
# dev/test=本机 127.0.0.1:54321（docs/families/saas.md 值表）；prod=远程 dev 机。
DB_CONNECTION=pgsql
PG_HOST=127.0.0.1
PG_PORT=54321
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=saas_dev

# —— JWT (HS256, ≥32B 硬约束, 全家族镜像同一 JWT_SIGNING_KEY，rails .env.example:23 同名) ——
# SSO 模式: laravel 只验签 saas IdP 签发的 token；prod 密钥由 deploy 脚本注入。
# iss/aud 值镜像 rails .env.example:24-25（终审 I-2：verify 开 verify_iss/verify_aud 同语义）。
JWT_SIGNING_KEY=dev-key-32-bytes-minimum-length!
JWT_TTL_SECONDS=3600
JWT_ISSUER=saas-identity-platform
JWT_AUDIENCE=saas-identity-platform-clients
