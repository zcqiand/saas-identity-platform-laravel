<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Contracts">
            <directory>tests/Contracts</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>routes</directory>
        </include>
    </source>
    <php>
        <!-- 测试期固定环境：DB 走 .env.test 的 PG 键（Laravel 按 APP_ENV 找 .env.<APP_ENV>，
             故 APP_ENV=test ⇔ 加载 .env.test，与 L0.5 进仓契约文件名一致；rails rake test
             同语义）。探活路由不挂 web 中间件组故无 session/cookie，无 APP_KEY 依赖；
             parity/health/smoke 不碰库，Laravel 惰性连接 → 天然零 PG 依赖。 -->
        <env name="APP_ENV" value="test"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
    </php>
    <extensions>
        <!-- trace 适配器：仅 TRACE_MAP=1（suite trace_env 注入）时写 .state/trace.json -->
        <bootstrap class="Harness\HarnessTraceExtension"/>
    </extensions>
</phpunit>
